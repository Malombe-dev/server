PORT=4000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/bsm for a local MongoDB)
MONGODB_URI=mongodb+srv://malombe:malombe123@malombe.suraiff.mongodb.net/bsm?appName=Malombe
# At least 32 random characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# The public address of the website (used for the origin check and links in emails). Comma-separate if you have several.
CLIENT_URL=http://localhost:3000
# First-run owner account. You must change the password at first login.
OWNER_EMAIL=owner@yourdomain.co.ke
OWNER_PASSWORD=ChangeMe123!
# Add sample services, packages and FAQs on first start (set false once you have your own)
SEED_SAMPLE=true
# Set false ONLY when running production mode over plain http (e.g. testing on localhost)
COOKIE_SECURE=true
# Optional: where uploaded images are stored (mount this as a persistent volume)
#UPLOAD_DIR=/data/uploads
# Cloudinary image storage (recommended). Copy the "API environment variable" from Cloudinary Console > Dashboard.
# If unset, images are saved to local disk (UPLOAD_DIR) instead.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# ...or set the three separately:
CLOUDINARY_CLOUD_NAME=dnmjvz8cy
CLOUDINARY_API_KEY=339763813995448
CLOUDINARY_API_SECRET=GFHKVEYx2oyNXZ1kTpMEcIChDdY
CLOUDINARY_FOLDER=bsm
# Optional fallback email credentials (normally you set these in Admin > Settings)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
